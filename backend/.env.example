# Dev
# DEBUG=true # makes cookies work on localhost without HTTPS
# PHOTO_UPLOAD_DIR=./uploads # so new devs know this exists, has a default as well
# ----------------
DEBUG=
PHOTO_UPLOAD_DIR=./uploads

# Database
# (Railway Postgres — grab from Railway dashboard → Variables)
# you need to manually update the +asyncpg from the copied value
# DATABASE_PUBLIC_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:PORT/railway
# ----------------
DATABASE_PUBLIC_URL=

# Auth
# $ python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=<run command above to generate>
# SESSION_LIFETIME_HOURS=168  # optional, this is the default
# CORS_ORIGINS=  # empty for dev (Vite proxy handles it)
# ----------------
SECRET_KEY=
SESSION_LIFETIME_HOURS=168
CORS_ORIGINS=

# Admin
# ADMIN_EMAIL=nicole.rowsey@gmail.com # an env var here for convenience
# ADMIN_PASSWORD=<pick-something-strong> # only needed for seed
# e.g. https://1password.com/password-generator
# ----------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Approval flow
# AUTO_APPROVE=false (set to true at the conference)
# ----------------
AUTO_APPROVE=

# S3-compatible image storage (Sprint 15)
# Cloudflare R2 (or DO Spaces / AWS S3 — same SDK, different endpoint)
# When S3_BUCKET_NAME is set, the app uses S3StorageBackend for photos.
# When unset, falls back to local filesystem (dev only — ephemeral on Railway).
# ----------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# Email notifications (fill in when that sprint arrives)
# For sending an email from your backend
# e.g. app automatically emails a provider when their profile gets approved
# e.g. send yourself a digest of new signups
# completely separate from mailto: link on profile page in the FE
# ----------------
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFICATION_EMAIL=
