# Database (Railway Postgres — grab from Railway dashboard → Variables)
DATABASE_PUBLIC_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:PORT/railway

# Auth
SECRET_KEY=change-me-to-a-random-string

# Admin
ADMIN_EMAIL=nicole@example.com

# Approval flow (set to true at the conference)
AUTO_APPROVE=false

